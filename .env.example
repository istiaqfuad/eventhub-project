# PostgreSQL (Neon) — use the pooled connection endpoint
DATABASE_URL=postgresql://ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=your_neon_user
DATABASE_PASSWORD=your_neon_password

# Auth
JWT_SECRET=your_secure_jwt_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Redis — REQUIRED, compose fails to start without it
REDIS_PASSWORD=your_strong_redis_password

# RabbitMQ — REQUIRED, compose fails to start without them
RABBITMQ_USER=eventhub
RABBITMQ_PASS=your_strong_rabbitmq_password
